{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "requirement.schema.json",
  "title": "Engineering Harness Requirements",
  "type": "object",
  "required": ["requirements"],
  "properties": {
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "statement", "priority", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^REQ-[0-9]+$"},
          "statement": {"type": "string", "minLength": 1},
          "source": {"enum": ["user", "spec"]},
          "priority": {"enum": ["must", "should", "could"]},
          "status": {"enum": ["pending", "implemented", "verified", "blocked"]},
          "evidence": {
            "type": "array",
            "items": {"type": ["string", "object"]}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
