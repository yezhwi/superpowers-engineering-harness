{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "candidate-proof.schema.json",
  "type": "object",
  "required": ["schema", "domain", "candidate_id", "proof_id", "spec_sha256", "execution", "record", "qualification"],
  "properties": {
    "schema": {"const": "candidate-proof/v1"},
    "domain": {"const": "harness:candidate-proof:v1"},
    "candidate_id": {"$ref": "#/definitions/digest"},
    "proof_id": {"$ref": "#/definitions/digest"},
    "spec_sha256": {"$ref": "#/definitions/digest"},
    "execution": {
      "type": "object",
      "required": ["profile", "argv", "exit_code", "candidate_tree", "parent_commit", "source_before", "source_after", "runtime", "dependencies", "source_config", "stdout_sha256", "stderr_sha256", "outputs"],
      "properties": {
        "profile": {"enum": ["pytest-junit-v1", "python-module-build-v1", "python-script-v1"]},
        "argv": {"type": "array", "minItems": 2, "items": {"type": "string"}},
        "exit_code": {"const": 0},
        "candidate_tree": {"$ref": "#/definitions/gitOid"},
        "parent_commit": {"$ref": "#/definitions/gitOid"},
        "source_before": {"$ref": "#/definitions/digest"},
        "source_after": {"$ref": "#/definitions/digest"},
        "runtime": {
          "type": "object",
          "required": ["implementation", "version", "executable", "resolved_executable", "executable_sha256"],
          "properties": {
            "implementation": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "executable": {"type": "string", "minLength": 1},
            "resolved_executable": {"type": "string", "minLength": 1},
            "executable_sha256": {"$ref": "#/definitions/digest"},
            "platform": {
              "type": "object", "required": ["system", "release", "version", "machine"], "additionalProperties": false,
              "properties": {"system": {"const": "Darwin"}, "release": {"type": "string"}, "version": {"type": "string"}, "machine": {"type": "string"}}
            },
            "native_inspector": {
              "type": "object", "required": ["source", "sha256"], "additionalProperties": false,
              "properties": {"source": {"type": "string"}, "sha256": {"$ref": "#/definitions/digest"}}
            },
            "runtime_inputs": {
              "type": "object", "required": ["stdlib_roots", "library_root", "files", "configuration"], "additionalProperties": false,
              "properties": {
                "stdlib_roots": {"type": "array", "minItems": 1, "items": {"type": "string"}},
                "library_root": {"type": "string"},
                "configuration": {"type": "object", "additionalProperties": {"oneOf": [{"type": "null"}, {"$ref": "#/definitions/digest"}]}},
                "files": {
                  "type": "array", "minItems": 1,
                  "items": {"type": "object", "required": ["source", "resolved", "sha256", "size"], "additionalProperties": false,
                    "properties": {"source": {"type": "string"}, "resolved": {"type": "string"}, "sha256": {"$ref": "#/definitions/digest"}, "size": {"type": "integer", "minimum": 0}}}
                }
              }
            }
          },
          "additionalProperties": false
        },
        "dependencies": {
          "type": "object",
          "required": ["files"],
          "properties": {
            "files": {
              "type": "array",
              "items": {"$ref": "#/definitions/fileFact"}
            }
          },
          "additionalProperties": false
        },
        "source_config": {
          "type": "object",
          "required": ["schema", "profile", "environment", "input_policy", "writable_paths"],
          "properties": {
            "schema": {"const": "candidate-proof-spec/v1"},
            "profile": {"enum": ["pytest-junit-v1", "python-module-build-v1", "python-script-v1"]},
            "environment": {
              "type": "object",
              "required": ["names", "declared", "ambient_inherited"],
              "properties": {
                "names": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
                "declared": {"type": "object", "additionalProperties": {"$ref": "#/definitions/digest"}},
                "ambient_inherited": {"type": "array", "maxItems": 0}
              },
              "additionalProperties": false
            },
            "input_policy": {
              "type": "object",
              "required": ["git", "hooks", "network", "secrets", "dynamic_dependencies"],
              "properties": {
                "git": {"const": "forbidden"},
                "hooks": {"const": "forbidden"},
                "network": {"const": "forbidden"},
                "secrets": {"const": "forbidden"},
                "dynamic_dependencies": {"const": "forbidden"}
              },
              "additionalProperties": false
            },
            "writable_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          },
          "additionalProperties": false
        },
        "stdout_sha256": {"$ref": "#/definitions/digest"},
        "stderr_sha256": {"$ref": "#/definitions/digest"},
        "outputs": {"type": "array", "items": {"$ref": "#/definitions/outputFact"}}
      },
      "additionalProperties": false
    },
    "record": {
      "type": "object",
      "required": ["type", "timestamp", "command", "exit_code", "execution_domain", "candidate_tree", "source_fingerprint", "covered_tests", "covered_test_cases", "executed_tests"],
      "properties": {
        "type": {"enum": ["build", "unit_test", "integration_test", "contract_test", "security", "custom"]},
        "timestamp": {"type": "string", "format": "date-time"},
        "command": {"type": "string", "minLength": 1},
        "exit_code": {"const": 0},
        "execution_domain": {"const": "outside-git"},
        "candidate_tree": {"$ref": "#/definitions/gitOid"},
        "source_fingerprint": {"$ref": "#/definitions/digest"},
        "covered_tests": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "covered_test_cases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^TC-[0-9]+$"}},
        "executed_tests": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "qualification": {
      "type": "object",
      "required": ["coverage_complete", "profile_version", "evidence_type", "bindings", "interfaces", "plan_items"],
      "properties": {
        "coverage_complete": {"const": true},
        "profile_version": {"const": "candidate-proof-profile/v1"},
        "evidence_type": {"enum": ["build", "unit_test", "integration_test", "contract_test", "security", "custom"]},
        "bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["case_ref", "obligation_ref", "tests", "executed_nodes"],
            "properties": {
              "case_ref": {"type": "string", "pattern": "^(REQ|INV)-[0-9]+/TC-[0-9]+$"},
              "obligation_ref": {"type": "string", "pattern": "^(REQ|INV)-[0-9]+$"},
              "tests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "executed_nodes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
            },
            "additionalProperties": false
          }
        },
        "interfaces": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^INT-[0-9]+$"}},
        "plan_items": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^P-[0-9]+$"}}
      },
      "additionalProperties": false
    }
  },
  "definitions": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "gitOid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "fileFact": {
      "type": "object",
      "required": ["source", "target", "sha256", "size"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/definitions/digest"},
        "size": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "outputFact": {
      "type": "object",
      "required": ["path", "sha256", "size"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/definitions/digest"},
        "size": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
