{
  "$schema":"http://json-schema.org/draft-07/schema#",
  "definitions":{
    "id":{"type":"string","pattern":"^[0-9a-f]{32}$"},
    "digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "identity":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"integer","minimum":0}},
    "path":{"type":"string","minLength":1,"maxLength":16384},
    "origin":{"type":"object","additionalProperties":false,"required":["workspace_id","generation_id","original_workspace_root"],"properties":{"workspace_id":{"$ref":"#/definitions/id"},"generation_id":{"$ref":"#/definitions/id"},"original_workspace_root":{"type":"string","pattern":"^/"}}},
    "object":{"type":"object","additionalProperties":false,"required":["path","category","kind","identity","sha256","origin"],"properties":{
      "path":{"$ref":"#/definitions/path"},"category":{"enum":["inputs","results","runtime","opaque"]},"kind":{"enum":["file","directory"]},"identity":{"$ref":"#/definitions/identity"},"sha256":{"$ref":"#/definitions/digest"},"origin":{"$ref":"#/definitions/origin"},
      "rebuild":{"type":"object","additionalProperties":false,"required":["command","input_refs"],"properties":{"command":{"type":"string","minLength":1,"maxLength":8192,"pattern":"\\S"},"input_refs":{"type":"array","minItems":1,"maxItems":128,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":16384}}}}
    }}
  },
  "type":"object","additionalProperties":false,
  "required":["version","kind","experiment_id","workspace_id","store_id","source_task","tool_identity","environment_identity","reference_scope","must_keep","objects"],
  "properties":{
    "version":{"const":1},"kind":{"const":"storage_experiment"},"experiment_id":{"$ref":"#/definitions/id"},"workspace_id":{"$ref":"#/definitions/id"},"store_id":{"$ref":"#/definitions/id"},
    "source_task":{"type":"object","additionalProperties":false,"required":["id","ref","origin","sha256"],"properties":{"id":{"type":"string","pattern":"^TASK-[0-9]+$"},"ref":{"type":"string","minLength":1,"maxLength":16384},"origin":{"$ref":"#/definitions/origin"},"sha256":{"$ref":"#/definitions/digest"}}},
    "tool_identity":{"$ref":"#/definitions/digest"},"environment_identity":{"$ref":"#/definitions/digest"},
    "reference_scope":{"enum":["declared_only","unknown"]},
    "must_keep":{"type":"array","maxItems":4096,"items":{"type":"object","additionalProperties":false,"required":["path","reason"],"properties":{"path":{"$ref":"#/definitions/path"},"reason":{"type":"string","minLength":1,"maxLength":2048}}}},
    "objects":{"type":"array","minItems":1,"maxItems":1024,"items":{"$ref":"#/definitions/object"}}
  }
}
