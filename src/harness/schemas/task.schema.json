{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "task.schema.json",
  "title": "Engineering Harness Task State",
  "type": "object",
  "required": [
    "task",
    "state"
  ],
  "properties": {
    "task": {
      "type": "object",
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^TASK-[0-9]+$"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "risk": {
      "type": ["object", "null"],
      "required": ["level", "profile", "dimensions", "escalation_history", "user_changes"],
      "properties": {
        "level": {"enum": ["Q1", "Q2", "Q3"]},
        "profile": {"enum": ["FAST", "STANDARD", "STRICT"]},
        "dimensions": {
          "type": "object",
          "required": ["scope", "contract", "data", "authorization", "security", "concurrency", "deployment"],
          "properties": {
            "scope": {"enum": ["low", "high"]},
            "contract": {"enum": ["none", "low", "high"]},
            "data": {"enum": ["none", "low", "high"]},
            "authorization": {"enum": ["none", "low", "high"]},
            "security": {"enum": ["none", "low", "high"]},
            "concurrency": {"enum": ["none", "low", "high"]},
            "deployment": {"enum": ["none", "low", "high"]}
          },
          "additionalProperties": false
        },
        "escalation_history": {"type": "array", "items": {"type": "object"}},
        "user_changes": {
          "type": "object",
          "required": ["paths", "fingerprint"],
          "properties": {
            "paths": {"type": "array", "items": {"type": "string"}},
            "fingerprint": {"type": "string"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "required": ["test_runs", "build_runs", "retry_runs", "overrides"],
      "properties": {
        "test_runs": {"type": "integer", "minimum": 0},
        "build_runs": {"type": "integer", "minimum": 0},
        "retry_runs": {"type": "integer", "minimum": 0},
        "overrides": {"type": "array", "items": {"type": "object", "required": ["action", "reason", "evidence", "hypothesis"], "additionalProperties": false, "properties": {"action": {"enum": ["test", "build", "retry"]}, "reason": {"type": "string"}, "evidence": {"type": "string"}, "hypothesis": {"type": "string"}}}}
      },
      "additionalProperties": false
    },
    "authorizations": {
      "type": "object",
      "propertyNames": {"enum": ["commit", "full_suite", "push", "create_mr", "ready_mr", "merge", "deploy"]},
      "additionalProperties": {
        "type": "object",
        "required": ["granted", "granted_at", "source"],
        "properties": {
          "granted": {"type": "boolean"},
          "granted_at": {"type": ["string", "null"]},
          "source": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "state": {
      "description": "Fixed enum; only CONVERGED -> DONE is legal",
      "enum": [
        "CREATED",
        "CLASSIFIED",
        "SPECIFYING",
        "PLANNED",
        "IMPLEMENTING",
        "VERIFYING",
        "REVIEWING",
        "REPRODUCING",
        "FIXING",
        "GATING",
        "BLOCKED",
        "CONVERGED",
        "DONE",
        "ESCALATED"
      ]
    },
    "previous_state": {
      "description": "Optional: last persisted state, used to re-check legality of the recorded transition",
      "enum": [
        "CREATED",
        "CLASSIFIED",
        "SPECIFYING",
        "PLANNED",
        "IMPLEMENTING",
        "VERIFYING",
        "REVIEWING",
        "REPRODUCING",
        "FIXING",
        "GATING",
        "BLOCKED",
        "CONVERGED",
        "DONE",
        "ESCALATED",
        null
      ]
    },
    "iteration": {
      "type": "integer",
      "minimum": 0
    },
    "max_iterations": {
      "type": "integer",
      "minimum": 1
    },
    "spec": {
      "type": "object",
      "properties": {
        "design": {
          "type": [
            "string",
            "null"
          ]
        },
        "plan": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "requirements": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "verified": {
          "type": "integer",
          "minimum": 0
        },
        "uncovered": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "invariants": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "verified": {
          "type": "integer",
          "minimum": 0
        },
        "violated": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "properties": {
        "build": {
          "type": "string"
        },
        "unit_test": {
          "type": "string"
        },
        "integration_test": {
          "type": "string"
        }
      }
    },
    "findings": {
      "type": "object",
      "properties": {
        "critical": {
          "type": "integer",
          "minimum": 0
        },
        "major": {
          "type": "integer",
          "minimum": 0
        },
        "minor": {
          "type": "integer",
          "minimum": 0
        },
        "confirmed": {
          "type": "integer",
          "minimum": 0
        },
        "proposed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "gate": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        },
        "blocked_by": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "category", "message"],
            "properties": {
              "code": {"type": "string"},
              "category": {"enum": ["verification", "implementation", "defect", "harness", "convergence"]},
              "message": {"type": "string"},
              "source": {"type": ["string", "null"]},
              "requirement_id": {"type": ["string", "null"]},
              "invariant_id": {"type": ["string", "null"]},
              "finding_id": {"type": ["string", "null"]},
              "recover_to": {"type": ["string", "null"]}
            },
            "additionalProperties": false
          }
        }
      }
    },
    "review": {
      "type": "object",
      "required": ["outcome", "reason_code", "message", "finding_ids"],
      "properties": {
        "outcome": {"enum": ["PASS", "VERIFICATION_GAP", "DEFECT"]},
        "reason_code": {"enum": ["REVIEW_CLEAN", "TEST_COVERAGE_INSUFFICIENT", "EVIDENCE_INCOMPLETE", "INVARIANT_UNPROVEN", "TEST_SCOPE_INSUFFICIENT", "LOGIC_ERROR", "REGRESSION", "CONTRACT_VIOLATION", "INVARIANT_VIOLATION"]},
        "message": {"type": "string"},
        "finding_ids": {"type": "array", "items": {"type": "string", "pattern": "^FND-[0-9]+$"}}
      },
      "additionalProperties": false
    },
    "git": {
      "type": "object",
      "properties": {
        "head": {
          "type": [
            "string",
            "null"
          ]
        },
        "base_commit": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "timestamps": {
      "type": "object",
      "properties": {
        "created_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "updated_at": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "allOf": [
    {"if": {"required": ["review"], "properties": {"review": {"properties": {"outcome": {"const": "PASS"}}}}}, "then": {"properties": {"review": {"properties": {"reason_code": {"const": "REVIEW_CLEAN"}, "finding_ids": {"maxItems": 0}}}}}},
    {"if": {"required": ["review"], "properties": {"review": {"properties": {"outcome": {"const": "VERIFICATION_GAP"}}}}}, "then": {"properties": {"review": {"properties": {"reason_code": {"enum": ["TEST_COVERAGE_INSUFFICIENT", "EVIDENCE_INCOMPLETE", "INVARIANT_UNPROVEN", "TEST_SCOPE_INSUFFICIENT"]}, "finding_ids": {"maxItems": 0}}}}}},
    {"if": {"required": ["review"], "properties": {"review": {"properties": {"outcome": {"const": "DEFECT"}}}}}, "then": {"properties": {"review": {"properties": {"reason_code": {"enum": ["LOGIC_ERROR", "REGRESSION", "CONTRACT_VIOLATION", "INVARIANT_VIOLATION"]}, "finding_ids": {"minItems": 1}}}}}}
  ]
}