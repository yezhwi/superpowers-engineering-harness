{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "invariant.schema.json",
  "title": "Engineering Harness Invariants",
  "type": "object",
  "required": ["invariants"],
  "properties": {
    "invariants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "statement", "category", "severity", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^INV-[0-9]+$"},
          "statement": {"type": "string", "minLength": 1},
          "category": {"enum": ["correctness", "transaction", "concurrency", "idempotency", "security", "authorization", "state_machine", "recovery", "data_consistency", "architecture"]},
          "severity": {"enum": ["critical", "major", "minor"]},
          "status": {"enum": ["pending", "verified", "violated"], "description": "pending = not proven (blocks for critical/major); verified = proven safe; violated = broken (always blocks)."},
          "verification": {"type": "array", "items": {"type": "string"}},
          "test_plan": {"$ref": "#/definitions/testPlan"}
        },
        "additionalProperties": false
      }
    }
  },
  "definitions": {
    "testPlan": {
      "type": "object",
      "required": ["strategies", "cases"],
      "properties": {
        "strategies": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["unit", "integration", "e2e", "regression", "concurrency", "security", "contract", "manual"]}
        },
        "cases": {
          "type": "array",
          "items": {"$ref": "#/definitions/testCase"}
        }
      },
      "additionalProperties": false
    },
    "testCase": {
      "type": "object",
      "required": ["id", "type", "strategy", "description"],
      "properties": {
        "id": {"type": "string", "pattern": "^TC-[0-9]+$"},
        "type": {"enum": ["happy_path", "negative", "boundary", "regression", "invariant", "concurrency", "security", "contract"]},
        "strategy": {"enum": ["unit", "integration", "e2e", "regression", "concurrency", "security", "contract", "manual"]},
        "description": {"type": "string", "minLength": 1},
        "tests": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
