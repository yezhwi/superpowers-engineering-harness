{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "type": "object", "additionalProperties": false,
 "required": ["version", "task_id", "baseline_hash", "audit_hash", "audit_head", "origin_decisions"],
 "properties": {
  "version": {"const": 1},
  "task_id": {"type": ["string", "null"], "pattern": "^TASK-[0-9]+$"},
  "baseline_hash": {"$ref": "#/definitions/hash"},
  "audit_hash": {"$ref": "#/definitions/hash"},
  "audit_head": {"$ref": "#/definitions/hash"},
  "origin_decisions": {"type": "object", "patternProperties": {"^DEC-[0-9]+$": {"$ref": "#/definitions/hash"}}, "additionalProperties": false}
 },
 "definitions": {"hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}
}
