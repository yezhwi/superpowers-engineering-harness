{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "id": {"type":"string","pattern":"^[0-9a-f]{32}$"},
    "digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "identity": {"type":"array","minItems":2,"maxItems":2,"items":{"type":"integer","minimum":0}},
    "nullableIdentity": {"anyOf":[{"type":"null"},{"$ref":"#/definitions/identity"}]},
    "nullableDigest": {"anyOf":[{"type":"null"},{"$ref":"#/definitions/digest"}]},
    "nullableId": {"anyOf":[{"type":"null"},{"$ref":"#/definitions/id"}]},
    "path": {"type":"string","minLength":1,"maxLength":16384},
    "node": {
      "type":"object","additionalProperties":false,"required":["identity","kind","sha256"],
      "properties":{"identity":{"$ref":"#/definitions/identity"},"kind":{"enum":["file","directory"]},"sha256":{"$ref":"#/definitions/nullableDigest"},"size":{"type":"integer","minimum":0}}
    },
    "action": {
      "type":"object","additionalProperties":false,"required":["kind","source","target","identity","content","sha256"],
      "properties": {
        "kind":{"enum":["mkdir","write","move","copy","archive_descriptor","history_overlay","reserve_ids","layout_metadata","candidate_binding"]},
        "source":{"anyOf":[{"type":"null"},{"$ref":"#/definitions/path"}]},
        "target":{"$ref":"#/definitions/path"},"identity":{"$ref":"#/definitions/nullableIdentity"},
        "content":{"type":["null","string"],"maxLength":524288},"sha256":{"$ref":"#/definitions/nullableDigest"}
      }
    },
    "migrationFact": {
      "type":"object","additionalProperties":false,"required":["identity"],
      "properties":{"identity":{"$ref":"#/definitions/identity"},"kind":{"enum":["directory","file","opaque"]},"size":{"type":"integer","minimum":0},"sha256":{"$ref":"#/definitions/digest"}}
    },
    "relocation": {
      "type":"object","additionalProperties":false,
      "required":["source","target","object_id","role","origin","logical_path"],
      "properties":{
        "source":{"$ref":"#/definitions/path"},"target":{"$ref":"#/definitions/path"},
        "object_id":{"$ref":"#/definitions/id"},"role":{"enum":["retained_root","history","experiment"]},
        "logical_path":{"$ref":"#/definitions/path"},"alias":{"type":"string","minLength":1,"pattern":"^[^/\\\\]+$"},
        "origin":{"type":"object","additionalProperties":false,"required":["workspace_id","generation_id","original_workspace_root"],"properties":{"workspace_id":{"$ref":"#/definitions/id"},"generation_id":{"$ref":"#/definitions/id"},"original_workspace_root":{"type":"string","pattern":"^/"}}}
      }
    },
    "qualification": {
      "type":"object","additionalProperties":false,
      "required":["workspace_identity","root_identity","product_fingerprint","sources","entries","logical_bytes","scan_complete","unsafe_nodes","blocked_reasons"],
      "properties":{
        "workspace_identity":{"$ref":"#/definitions/identity"},"root_identity":{"$ref":"#/definitions/identity"},
        "product_fingerprint":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
        "sources":{"type":"object","maxProperties":16,"additionalProperties":{"$ref":"#/definitions/migrationFact"}},
        "entries":{"type":"object","maxProperties":100000,"additionalProperties":{"$ref":"#/definitions/migrationFact"}},
        "logical_bytes_complete":{"type":"boolean"},"logical_bytes":{"type":"integer","minimum":0},"scan_complete":{"type":"boolean"},"unsafe_nodes":{"type":"boolean"},
        "blocked_reasons":{"type":"array","uniqueItems":true,"items":{"enum":["STORE_READER_UNSUPPORTED","STORE_UNSAFE_NODE","STORE_PLAN_STALE"]}},
        "limits":{"type":"object","additionalProperties":false,"required":["max_nodes","max_bytes"],"properties":{"max_nodes":{"type":"integer","minimum":1,"maximum":100000},"max_bytes":{"type":"integer","minimum":1,"maximum":1073741824}}},
        "index_before":{"type":"object"},"index_sha256":{"$ref":"#/definitions/digest"},
        "reader":{"type":"object","additionalProperties":false,"required":["version","capability","schemas","modules"],"properties":{
          "version":{"const":1},"capability":{"const":"harness-storage-layout/v1"},
          "schemas":{"type":"object","maxProperties":256,"additionalProperties":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}},
          "modules":{"type":"object","maxProperties":64,"additionalProperties":{"type":"object","additionalProperties":false,"required":["path","identity","sha256"],"properties":{"path":{"type":"string","pattern":"^/"},"identity":{"$ref":"#/definitions/identity"},"sha256":{"$ref":"#/definitions/digest"}}}}
        }}
      }
    },
    "plan": {
      "type":"object","additionalProperties":false,
      "required":["version","kind","operation","operation_id","workspace_root","workspace_id","store_id","old_generation_id","candidate_generation_id","task_id","head","scope_digest","manifest_digest","ready","actions","plan_digest"],
      "properties": {
        "version":{"const":1},"kind":{"const":"storage_plan"},"operation":{"enum":["ACTIVATE","M1","M2","TURNOVER"]},
        "operation_id":{"$ref":"#/definitions/id"},"workspace_root":{"type":"string","pattern":"^/"},
        "workspace_id":{"$ref":"#/definitions/id"},"store_id":{"$ref":"#/definitions/id"},
        "old_generation_id":{"$ref":"#/definitions/nullableId"},"candidate_generation_id":{"$ref":"#/definitions/nullableId"},
        "task_id":{"type":["null","string"],"pattern":"^TASK-[0-9]+$"},"head":{"type":"string","pattern":"^[0-9a-f]{40,64}$"},
        "scope_digest":{"$ref":"#/definitions/digest"},"manifest_digest":{"$ref":"#/definitions/digest"},"plan_digest":{"$ref":"#/definitions/digest"},
        "relocations":{"type":"array","minItems":1,"maxItems":64,"items":{"$ref":"#/definitions/relocation"}},
        "turnover":{"type":"object","additionalProperties":false,"required":["kind","task_id","candidate_path","archive_id","template_sources"],"properties":{"kind":{"enum":["NEW","RECOVER"]},"task_id":{"type":"string","pattern":"^TASK-[0-9]+$"},"candidate_path":{"$ref":"#/definitions/path"},"archive_id":{"$ref":"#/definitions/id"},"template_sources":{"type":"object","maxProperties":16,"additionalProperties":{"$ref":"#/definitions/migrationFact"}}}},"qualification":{"$ref":"#/definitions/qualification"},"ready":{"type":"boolean"},"actions":{"type":"array","maxItems":1024,"items":{"$ref":"#/definitions/action"}}
      }
    },
    "maintenance": {
      "type":"object","additionalProperties":false,
      "required":["version","workspace_id","operation","plan_digest","participants","participants_complete","operator_confirmation"],
      "properties":{
        "version":{"const":1},"workspace_id":{"$ref":"#/definitions/id"},"operation":{"enum":["ACTIVATE","M1","M2"]},
        "plan_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
        "participants_complete":{"const":true},"operator_confirmation":{"const":true},
        "participants":{"type":"array","minItems":1,"maxItems":1024,"items":{"type":"object","additionalProperties":false,
          "required":["name","role","disposition","capabilities"],
          "properties":{"name":{"type":"string","minLength":1},"role":{"enum":["cli","agent","ci","test","build","editor","external_writer"]},"disposition":{"enum":["stopped","upgraded"]},"capabilities":{"type":"array","items":{"type":"string"}}}}}
      }
    },
    "authority": {
      "type":"object","additionalProperties":false,"required":["version","decision_id","plan_digest","grant_digest","maintenance_digest"],
      "properties":{"version":{"const":1},"decision_id":{"type":"string","pattern":"^DEC-[0-9]+$"},"plan_digest":{"$ref":"#/definitions/digest"},"grant_digest":{"$ref":"#/definitions/digest"},"maintenance_digest":{"$ref":"#/definitions/digest"},"turnover_policy":{"type":"object","additionalProperties":false,"required":["activation_operation_id","activation_descriptor_digest","binding_digest"],"properties":{"activation_operation_id":{"$ref":"#/definitions/id"},"activation_descriptor_digest":{"$ref":"#/definitions/digest"},"binding_digest":{"$ref":"#/definitions/digest"}}},"sources":{"type":"object","maxProperties":2,"additionalProperties":{"$ref":"#/definitions/migrationFact"}},"maintenance_snapshot":{"$ref":"#/definitions/maintenance"}}
    },
    "descriptor": {
      "type":"object","additionalProperties":false,
      "required":["version","kind","id","workspace_root","repo_identity","root_identity","store_identity","frames_path","frames_identity","active_parent_identity","parents","sources","plan","authority"],
      "properties": {
        "version":{"const":3},"kind":{"enum":["storage_activation","storage_directory"]},"id":{"$ref":"#/definitions/id"},
        "workspace_root":{"type":"string","pattern":"^/"},"repo_identity":{"$ref":"#/definitions/identity"},"root_identity":{"$ref":"#/definitions/identity"},
        "store_identity":{"$ref":"#/definitions/nullableIdentity"},"frames_path":{"$ref":"#/definitions/path"},"frames_identity":{"$ref":"#/definitions/identity"},
        "active_parent_identity":{"$ref":"#/definitions/identity"},
        "parents":{"type":"object","maxProperties":8192,"additionalProperties":{"$ref":"#/definitions/identity"}},
        "sources":{"type":"object","maxProperties":1024,"additionalProperties":{"$ref":"#/definitions/node"}},
        "plan":{"$ref":"#/definitions/plan"},"authority":{"$ref":"#/definitions/authority"}
      }
    },
    "frame": {
      "type":"object","additionalProperties":false,"required":["version","kind","operation_id","sequence","previous_hash","event","action","node"],
      "properties": {
        "version":{"const":1},"kind":{"const":"storage_frame"},"operation_id":{"$ref":"#/definitions/id"},
        "sequence":{"type":"integer","minimum":1,"maximum":8192},"previous_hash":{"$ref":"#/definitions/digest"},
        "event":{"enum":["INTENT","ACK","CANCEL","COMMIT_INTENT","COMMITTED","ABORT_INTENT","UNDO_INTENT","UNDONE","ABORTED"]},
        "action":{"type":["null","integer"],"minimum":0,"maximum":1023},"node":{"anyOf":[{"type":"null"},{"$ref":"#/definitions/node"}]}
      }
    }
  },
  "oneOf":[{"$ref":"#/definitions/plan"},{"$ref":"#/definitions/authority"},{"$ref":"#/definitions/descriptor"},{"$ref":"#/definitions/frame"}]
}
