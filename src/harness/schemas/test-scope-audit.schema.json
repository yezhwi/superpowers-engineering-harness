{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "type": "object", "additionalProperties": false,
 "required": ["version", "task_id", "entries"],
 "properties": {
  "version": {"const": 1},
  "task_id": {"type": ["string", "null"], "pattern": "^TASK-[0-9]+$"},
  "entries": {"type": "array", "items": {
   "type": "object", "additionalProperties": false,
   "required": ["sequence", "previous_hash", "hash", "timestamp", "operation", "before_tests", "after_tests", "decision_refs", "artifact_hashes", "reason_code", "affected_bindings", "plan_refs"],
   "properties": {
    "sequence": {"type": "integer", "minimum": 1},
    "previous_hash": {"$ref": "#/definitions/hash"}, "hash": {"$ref": "#/definitions/hash"},
    "timestamp": {"type": "string", "minLength": 1},
    "operation": {"enum": ["ADD", "RETIRE", "REBIND", "HISTORICAL_ADD"]},
    "before_tests": {"$ref": "#/definitions/tests"}, "after_tests": {"$ref": "#/definitions/tests"},
    "decision_refs": {"type": "array", "items": {"type": "object", "required": ["id", "option", "hash"], "additionalProperties": false, "properties": {"id": {"type": "string", "pattern": "^DEC-[0-9]+$"}, "option": {"type": "string", "minLength": 1}, "hash": {"$ref": "#/definitions/hash"}}}},
    "artifact_hashes": {"type": "object", "required": ["impact.yaml"], "additionalProperties": {"type": "object", "required": ["before", "after"], "additionalProperties": false, "properties": {"before": {"$ref": "#/definitions/hash"}, "after": {"$ref": "#/definitions/hash"}}}},
    "reason_code": {"type": "string", "minLength": 1},
    "affected_bindings": {"type": "array", "items": {"type": "object", "required": ["owner", "case", "before", "after"], "additionalProperties": false, "properties": {"owner": {"type": "string", "pattern": "^(REQ|INV)-[0-9]+$"}, "case": {"type": "string", "pattern": "^TC-[0-9]+$"}, "before": {"$ref": "#/definitions/tests"}, "after": {"$ref": "#/definitions/tests"}}}},
    "plan_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^P-[0-9]+$"}}
   }
  }}
 },
 "definitions": {
  "hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
  "tests": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
 }
}
