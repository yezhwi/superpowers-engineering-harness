{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harness Evidence",
  "description": "Deterministic evidence bound to a Git commit. LAW 2: no quality gate pass without fresh evidence.",
  "type": "object",
  "properties": {
    "type": {
      "enum": [
        "build",
        "lint",
        "typecheck",
        "unit_test",
        "integration_test",
        "contract_test",
        "security",
        "review",
        "diagnosability_review",
        "custom"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "command": {
      "type": "string"
    },
    "exit_code": {
      "type": "integer"
    },
    "commit": {
      "type": "string",
      "description": "Git HEAD (full sha) the command ran against"
    },
    "stdout_tail": {
      "type": [
        "string",
        "null"
      ]
    },
    "stderr_tail": {
      "type": [
        "string",
        "null"
      ]
    },
    "workspace_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Business workspace snapshot before command; excludes .harness runtime state."
    },
    "workspace_fingerprint_after": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Business workspace snapshot after command; must equal workspace_fingerprint."
    },
    "scope": {
      "enum": ["related", "full_suite"]
    },
    "covered_tests": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "covered_test_cases": {
      "type": "array",
      "items": {"type": "string", "pattern": "^TC-[0-9]+$"},
      "uniqueItems": true
    },
    "subject": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": {"const": "finding"},
        "id": {"type": "string", "pattern": "^FND-[0-9]+$"}
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": ["implementation", "version", "executable", "platform"],
      "properties": {
        "implementation": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "executable": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "test": {
      "type": "object",
      "required": ["node_id"],
      "properties": {"node_id": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    }
  },
  "required": [
    "type",
    "timestamp",
    "command",
    "exit_code",
    "commit"
  ],
  "allOf": [
    {"if": {"required": ["subject"]}, "then": {"required": ["test"]}},
    {"if": {"required": ["test"]}, "then": {"required": ["subject"]}}
  ]
}